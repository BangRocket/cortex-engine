# Copy to .env and fill in. .env is gitignored; this file is not.

# --- Anthropic (perception, deliberation, mem0 consolidation)
ANTHROPIC_API_KEY=
# custom API endpoint (proxy, gateway, self-hosted); leave empty for api.anthropic.com
# used for both perception/deliberation and mem0 consolidation
ANTHROPIC_BASE_URL=

# --- LLM
LIDA_LLM_MODEL=claude-sonnet-5-5
# model mem0 uses to extract declarative facts; defaults to LIDA_LLM_MODEL
# LIDA_MEM0_LLM_MODEL=claude-haiku-5-5
# ceiling per call; thinking tokens count against it
LIDA_LLM_MAX_TOKENS=16000
# thinking depth: low|medium|high|xhigh|max (empty = model default, high on Sonnet 5.5)
LIDA_LLM_EFFORT=low
# on a safety refusal, retry on a fallback model the API picks; empty disables
# (set empty if your model or ANTHROPIC_BASE_URL gateway rejects it)
LIDA_LLM_FALLBACKS=default

# --- Embeddings / storage
# BAAI/bge-small-en-v1.5 (384d, fast) or BAAI/bge-base-en-v1.5 (768d, better)
LIDA_EMBED_MODEL=BAAI/bge-small-en-v1.5
LIDA_STORE_PATH=./lida_qdrant
LIDA_SCHEME_STATS_PATH=scheme_stats.json
LIDA_HISTORY_DB_PATH=./lida_history.db
LIDA_USER_ID=demo-user

# --- Who the agent is (paths relative to lida-llm.py)
# personality: system prompt for deliberation (same format as rumination-engine)
LIDA_PERSONALITY_FILE=personalities/clara.txt
# prompt: the first thing the agent perceives
LIDA_PROMPT_FILE=prompt.txt
# goals: one per line; each one pulls related content into attention
# goals.txt is only the seed: once she revises her goals, the live list is kept below
LIDA_GOALS_FILE=goals.txt
# her lasting traits: shown with her goals but fixed, and not attention codelets
LIDA_VALUES_FILE=values.txt
# 1 = she can add, drop and reword her own goals; 0 = goals stay fixed
LIDA_SELF_GOALS=1
LIDA_LIVE_GOALS_PATH=./lida_goals.json
# one JSON line per change: when, why, before, after
LIDA_GOALS_LOG_PATH=./lida_goals_log.jsonl
# what she's working toward across actions (she sets it when deliberating)
LIDA_INTENTION_PATH=./lida_intention.json
LIDA_MAX_GOALS=7
# minutes between goal checks: the next deliberation weighs her goals against
# how much attention each actually won, and she revises or says why they fit (0 = off)
LIDA_GOAL_REVIEW_MINUTES=30

# --- Cognitive cycle tuning
LIDA_BROADCAST_THRESHOLD=0.25
LIDA_AUTOMATIC_THRESHOLD=0.55
LIDA_REFRACTORY_TAU=3.0
LIDA_CONSOLIDATE_EVERY=10
# workspace items this similar (raw cosine) merge as one thought; higher = merge less
LIDA_DEDUPE_SIM=0.88
# memories recalled by each broadcast, so one thought can lead to the next (0 = off)
LIDA_BROADCAST_CUE_K=3
# a new memory this similar (raw cosine) reuses the existing one instead of adding
# a copy; merged facts take the newer wording. Higher = merge less.
LIDA_SAME_EPISODE_SIM=0.95
LIDA_SAME_FACT_SIM=0.90
LIDA_SAME_HABIT_SIM=0.90
# minimum seconds between actions; each one costs LLM calls, so this paces spend
LIDA_ACTION_INTERVAL=30
# seconds with nothing reaching attention before the mind wanders to its next goal
LIDA_IDLE_SECONDS=10

# --- Web access (Anthropic-hosted web_search + web_fetch, used when carrying out actions)
# 1 = on, 0 = off (actions are then only chosen, never carried out)
LIDA_WEB=1
# max searches and max fetches per action
LIDA_WEB_MAX_USES=3
# max tokens of a fetched page that get read
LIDA_WEB_MAX_CONTENT_TOKENS=8000

# --- Her workspace folder (the only files she can list, read, write, edit, delete)
# 1 = on, 0 = off. Paths outside the folder, including via symlinks, are refused.
LIDA_FILES=1
LIDA_FILES_DIR=./workspace
# limits: per file, and for the whole folder
LIDA_FILES_MAX_KB=200
LIDA_FILES_MAX_TOTAL_MB=50

# --- Running Python she writes (sandboxed with bubblewrap: sees only her workspace
# folder, no .env, no home, no env vars; turns itself off if bwrap is missing)
LIDA_EXEC=1
LIDA_EXEC_TIMEOUT=30
LIDA_EXEC_MEMORY_MB=512
LIDA_EXEC_MAX_PROCS=32
# 1 lets her code use the network (off by default)
LIDA_EXEC_NETWORK=0

# --- Asking questions
# she can ask the person running her a question (it never waits for the answer);
# anything typed into the terminal reaches her as input
LIDA_ASK=1
LIDA_USER_NAME=Joshua
# an unanswered question blocks new ones for this many seconds
LIDA_ASK_EXPIRE_SECONDS=1800

# --- Decision model
# who judges whether an action worked: llm (Claude) or jev (TypeSafe's Jev;
# falls back to Claude if Jev errors). Jev's probability also feeds habit learning.
LIDA_DECIDER=llm
JEV_API_KEY=
JEV_MODEL=jev-latest
# probability Jev must give for an action to count as worked
JEV_WORKED_THRESHOLD=0.5
JEV_TIMEOUT=10

# --- Console output
# 1 = show each step (embedding, recall, LLM calls) with timings; 0 = only actions/broadcasts
LIDA_VERBOSE=1
# seconds of silence before a heartbeat line reports what's still running
LIDA_HEARTBEAT_SECONDS=5
# color log lines by source (Claude, Jev, memory, cycle...): auto = only on a
# terminal and when NO_COLOR is unset; 1 = always; 0 = never
LIDA_COLOR=auto

# --- Third-party
# where mem0 keeps its own files (telemetry id, migrations store); kept in the
# project so reset_memory.py clears it. mem0's default is the shared ~/.mem0
MEM0_DIR=./lida_mem0
# mem0 sends anonymous usage telemetry (PostHog) unless disabled
MEM0_TELEMETRY=False
# where Hugging Face caches downloaded embedding models
# HF_HOME=~/.cache/huggingface
# optional Hugging Face token; avoids the "unauthenticated requests" warning
# HF_TOKEN=
# once the embedding model is downloaded, skip the Hub check on every start
# HF_HUB_OFFLINE=1
